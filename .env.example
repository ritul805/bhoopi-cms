# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Authentication / Security
JWT_SECRET=your_random_32_byte_jwt_secret

# Direct Postgres connection — used ONLY by scripts/db/* maintenance scripts.
# Not needed to run the app. Keep this in .env.local (untracked), never here.
# Rotate immediately if it is ever committed or shared.
# DATABASE_URL=postgresql://user:password@db.your-project.supabase.co:5432/postgres
